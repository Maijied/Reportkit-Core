Route::group(['prefix' => 'admin', 'middleware' => ['web', 'auth']], function () {
    // After: php artisan reportkit:make OperatorExport --preset=hybrid-export --route=admin/operator-export
    Route::get('operator-export', 'OperatorExportController@index');
    Route::get('operator-export/weeks', 'OperatorExportController@weeks');
    Route::get('operator-export/rows', 'OperatorExportController@rows');
});

Route::post('reportkit/operator-export/send', 'OperatorExportController@send');
