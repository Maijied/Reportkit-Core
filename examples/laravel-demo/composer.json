{
  "name": "lorapok/reportkit-laravel-demo",
  "description": "Fictional Laravel 5.4 host demonstrating ReportKit LLDP hybrid-export",
  "type": "project",
  "license": "LicenseRef-Lorapok-NCL-1.0",
  "require": {
    "php": ">=5.6.4",
    "laravel/framework": "5.4.*",
    "reportkit/core": "@dev",
    "reportkit/laravel-legacy": "@dev"
  },
  "require-dev": {
    "phpunit/phpunit": "^5.7|^9.0"
  },
  "repositories": [
    { "type": "path", "url": "../../reportkit-core" },
    { "type": "path", "url": "../../reportkit-laravel-legacy" }
  ],
  "autoload": {
    "classmap": [
      "database"
    ],
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "php artisan key:generate"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
