{
  "name": "reportkit-website",
  "version": "0.1.0",
  "private": true,
  "description": "ReportKit product website + Bootstrap-style docs — Lorapok Labs",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/sync-ui-assets.mjs && node scripts/sync-docs.mjs && node scripts/fetch-versions.mjs && astro build && node scripts/copy-cname.mjs && npx --yes pagefind --site dist",
