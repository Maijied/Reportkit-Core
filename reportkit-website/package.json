    "sync-docs": "node scripts/sync-docs.mjs",
    "fetch-versions": "node scripts/fetch-versions.mjs",
    "check": "astro check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.0",
    "@astrojs/sitemap": "^3.3.0",
