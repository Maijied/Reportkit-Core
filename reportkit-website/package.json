    "bootstrap": "^5.3.3",
    "motion": "^12.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.62.1",
    "pagefind": "^1.5.2",
    "sass": "^1.85.0",
    "typescript": "^5.8.2"
  },
