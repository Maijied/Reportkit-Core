{
  "ci": {
    "collect": {
      "staticDistDir": "./reportkit-website/dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/features/index.html",
        "http://localhost/simulation/index.html",
        "http://localhost/docs/0.1/getting-started/introduction/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
