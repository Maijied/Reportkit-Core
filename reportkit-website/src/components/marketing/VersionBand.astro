---
import versions from '../../data/versions.json';

const rows = Object.values(versions.packages || {});
---
<section class="rk-section border-top">
  <div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
      <div>
        <div class="rk-kicker"><span class="rk-brand-dot"></span> Live versions</div>
        <h2 class="rk-section-title mb-1">Beta channel is current</h2>
        <p class="text-secondary mb-0 small">
          Generated {versions.generated_at ? new Date(versions.generated_at).toISOString().slice(0, 10) : 'at build'} ·
          install with <code>@beta</code> until stable cuts.
        </p>
      </div>
      <a class="btn rk-btn-ghost btn-sm" href="https://github.com/Maijied/Reportkit-Core/blob/main/reportkit-website/VERSIONING.md">Versioning docs</a>
    </div>
    <div class="row g-3">
      {rows.map((pkg) => {
        const rel = pkg.release || {};
        const beta = rel.beta?.version;
        const stable = rel.stable?.version || (!rel.prerelease ? rel.version : null);
        const current = rel.version;
        const label = pkg.composer || pkg.npm;
        return (
          <div class="col-md-6 col-lg-3" data-rk-reveal>
            <div class="rk-card h-100">
              <div class="small text-secondary mb-1">{label}</div>
              <div class="rk-mono fw-bold">{current}</div>
              <div class="small mt-2">
                {beta && <span class="rk-badge-provenance" data-provenance="synthetic">beta {beta}</span>}{' '}
                {stable && <span class="rk-badge-provenance" data-provenance="live">stable {stable}</span>}
              </div>
              <a class="small d-inline-block mt-2" href={rel.url}>Release</a>
            </div>
          </div>
        );
      })}
    </div>
    <pre class="mt-4 mb-0"><code>{versions.install?.beta?.composer}</code></pre>
  </div>
</section>
