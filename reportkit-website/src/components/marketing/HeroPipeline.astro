---
import PrepareSequenceAnimation from './PrepareSequenceAnimation.astro';
---
<section class="rk-hero">
  <div class="container rk-hero-inner">
    <div class="row align-items-center g-4 g-lg-5">
      <div class="col-lg-5">
        <div class="rk-kicker">
          <span class="rk-brand-dot"></span>
          Lorapok Labs product
        </div>
        <h1 class="rk-hero-title">Multi-DB reports that stay fast.</h1>
        <p class="rk-hero-lead">
          ReportKit owns week chunking, filter validation, merge → dedupe → slice,
          and DataTables JSON. Your host keeps the SQL — across live and archive databases.
        </p>
        <div class="rk-hero-actions">
          <a class="btn rk-btn-primary" href="/docs/0.1/getting-started/quick-start">Quick start</a>
          <a class="btn rk-btn-ghost" href="/simulation">Watch pipeline simulation</a>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <span class="rk-badge-provenance" data-provenance="live">PHP 5.6 → 8.5</span>
          <span class="rk-badge-provenance" data-provenance="live">Laravel 4.1 → 13</span>
          <span class="rk-badge-provenance" data-provenance="synthetic">Fictional demo only</span>
        </div>
      </div>
      <div class="col-lg-7">
        <div class="rk-flow-shell">
          <PrepareSequenceAnimation />
        </div>
        <p class="small mt-2 mb-0" style="color: rgba(238,247,242,0.55)">
          18-step prepare → compose → send animation — scroll replay or open the
          <a href="/simulation" style="color:#9fd9bc">interactive lab</a>.
        </p>
      </div>
    </div>
  </div>
</section>
