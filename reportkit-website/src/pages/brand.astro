---
import MarketingLayout from '../layouts/MarketingLayout.astro';

const logos = [
  {
    name: 'Primary mark',
    file: '/brand/reportkit-mark.svg',
    png: '/brand/png/reportkit-mark-1024.png',
    note: 'Transparent. Use everywhere the product name already appears in text.',
    bg: '#ffffff',
  },
  {
    name: 'Horizontal lockup',
    file: '/brand/reportkit-logo.svg',
    png: '/brand/png/reportkit-logo-1200.png',
    note: 'Mark + wordmark + tagline, for light backgrounds.',
    bg: '#ffffff',
  },
  {
    name: 'Lockup (inverse)',
    file: '/brand/reportkit-logo-inverse.svg',
    png: '/brand/png/reportkit-logo-inverse-1200.png',
    note: 'For dark backgrounds and dark-mode docs.',
    bg: '#0a1410',
  },
  {
    name: 'App icon',
    file: '/brand/reportkit-icon.svg',
    png: '/brand/png/reportkit-icon-512.png',
    note: 'Emerald badge. Social avatars and app tiles.',
    bg: '#f4f6f5',
  },
  {
    name: 'Small-size icon',
    file: '/brand/reportkit-icon-small.svg',
    png: '/brand/png/reportkit-icon-small-512.png',
    note: 'Simplified glyph that stays legible at 16–32px. Source of favicon.ico.',
    bg: '#f4f6f5',
  },
];

const animated = [
  {
    name: 'Kit-Larva idle',
    file: '/brand/animated/kit-larva-idle.svg',
    note: 'Eye blink, neon panel pulse, subtle peristalsis. Docs hero & README.',
    size: 160,
    bg: '#0a1410',
  },
  {
    name: 'Kit-Larva prepare',
    file: '/brand/animated/kit-larva-prepare.svg',
    note: 'Segment wave + data flow during prepare. Async loader overlay.',
    size: 160,
    bg: '#0a1410',
  },
  {
    name: 'LLDP flow',
    file: '/brand/animated/lldp-flow.svg',
    note: 'Prepare → Secure Store → Compose → Deliver phase rail.',
    size: '100%',
    bg: '#060908',
    wide: true,
  },
  {
    name: 'ReportKit loader',
    file: '/brand/animated/reportkit-loader.svg',
    note: 'Compact 128px spinner for inline loading states.',
    size: 96,
    bg: '#0a1410',
  },
];

const palette = [
  { name: 'Accent / live', hex: '#0b7a4b', fg: '#fff' },
  { name: 'Mint', hex: '#34c98a', fg: '#08130f' },
  { name: 'Mint light', hex: '#8ef0c4', fg: '#08130f' },
  { name: 'Archive signal', hex: '#f0ad4e', fg: '#08130f' },
  { name: 'Ink deep', hex: '#08130f', fg: '#fff' },
];
---

<MarketingLayout title="Brand · ReportKit" description="ReportKit brand kit — logo, icon, palette and typography from Lorapok Labs.">
  <section class="rk-section">
    <div class="container">
      <div class="rk-kicker"><span class="rk-brand-dot"></span> Brand kit</div>
      <h1 class="rk-section-title">ReportKit brand</h1>
      <p class="text-secondary col-lg-8">
        The mark shows the product in one picture: two databases streaming into a merge node,
        emerging as a single report. Every asset is vector-first and transparent.
      </p>

      <h2 class="h4 mt-5 mb-3">Logos</h2>
      <div class="row g-3">
        {logos.map((l) => (
          <div class="col-md-6">
            <div class="rk-card h-100">
              <div
                class="d-flex align-items-center justify-content-center rounded mb-3"
                style={`background:${l.bg};min-height:170px;padding:1.25rem`}
              >
                <img src={l.file} alt={`ReportKit ${l.name}`} style="max-width:100%;max-height:130px" />
              </div>
              <div class="fw-bold">{l.name}</div>
              <p class="text-secondary small mb-2">{l.note}</p>
              <a class="btn rk-btn-ghost btn-sm" href={l.file} download>SVG</a>
              <a class="btn rk-btn-ghost btn-sm" href={l.png} download>PNG</a>
            </div>
          </div>
        ))}
      </div>

      <h2 class="h4 mt-5 mb-3">Animated SVG</h2>
      <p class="text-secondary col-lg-9">
        Vector animations with CSS keyframes. Inline or use <code>&lt;object type="image/svg+xml"&gt;</code> so motion plays.
        Respects <code>prefers-reduced-motion</code>. GIF fallbacks live beside these in <code>/brand/animated/</code>.
      </p>
      <div class="row g-3">
        {animated.map((a) => (
          <div class={a.wide ? 'col-12' : 'col-md-6 col-lg-3'}>
            <div class="rk-card h-100">
              <div
                class="d-flex align-items-center justify-content-center rounded mb-3"
                style={`background:${a.bg};min-height:${a.wide ? '200px' : '180px'};padding:1rem`}
              >
                <object
                  type="image/svg+xml"
                  data={a.file}
                  aria-label={`ReportKit ${a.name} animation`}
                  style={a.wide ? 'width:100%;max-height:180px' : `width:${a.size}px;height:${a.size}px`}
                />
              </div>
              <div class="fw-bold">{a.name}</div>
              <p class="text-secondary small mb-2">{a.note}</p>
              <a class="btn rk-btn-ghost btn-sm" href={a.file} download>SVG</a>
            </div>
          </div>
        ))}
      </div>

      <h2 class="h4 mt-5 mb-3">Palette</h2>
      <div class="row g-3">
        {palette.map((c) => (
          <div class="col-6 col-md">
            <div class="rk-card" style={`background:${c.hex};color:${c.fg};min-height:130px`}>
              <div class="fw-bold">{c.name}</div>
              <div class="rk-mono">{c.hex}</div>
            </div>
          </div>
        ))}
      </div>

      <h2 class="h4 mt-5 mb-3">Typography</h2>
      <p class="text-secondary">
        Display: <strong>Sora</strong> · Body: <strong>Manrope</strong> · Mono: <strong>JetBrains Mono</strong>.
        The lockups reference this stack, so they render in the brand font wherever those fonts are loaded.
      </p>

      <h2 class="h4 mt-5 mb-3">Usage</h2>
      <ul class="text-secondary">
        <li>Keep clear space around the mark equal to the height of one database cylinder.</li>
        <li>Don’t recolour, rotate, stretch, or add effects to the mark.</li>
        <li>On dark backgrounds use the inverse lockup rather than the light one.</li>
        <li>Below 32px use the small-size icon — the detailed mark loses legibility.</li>
      </ul>

      <p class="mt-4">
        Product of <a href="https://lorapok.tech">Lorapok Labs</a>. Assets ship under the project license.
      </p>
    </div>
  </section>
</MarketingLayout>
