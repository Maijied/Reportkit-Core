---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---
<MarketingLayout title="Not found · ReportKit">
  <section class="rk-section">
    <div class="container text-center py-5">
      <div class="rk-kicker justify-content-center"><span class="rk-brand-dot"></span> 404</div>
      <h1 class="rk-section-title">This row was deduped out of existence.</h1>
      <p class="text-secondary">The page you wanted isn’t in the merge set.</p>
      <a class="btn rk-btn-primary" href="/">Back home</a>
      <a class="btn rk-btn-ghost ms-2" href="/docs/0.1/getting-started/introduction" style="color:#0b7a4b;border-color:#0b7a4b">Docs</a>
    </div>
  </section>
</MarketingLayout>
